# PostgreSQL 连接串（Prisma CLI 与 NestJS 运行时共用）
# 复制本文件为 .env 后填入真实密码；.env 已被 .gitignore 忽略，不会提交
DATABASE_URL="postgresql://postgres:REPLACE_ME@localhost:5432/ai_ad_copilot?schema=public"

# Memurai / Redis（兼容 Redis 协议），默认无密码
REDIS_URL="redis://localhost:6379"

# overview 缓存 TTL（秒），契约要求 5 分钟
CACHE_TTL_SECONDS=300

# 缓存 key 前缀：多环境共用同一个 Redis 实例时用于隔离
CACHE_KEY_PREFIX=ai-ad-copilot

# 服务监听端口
PORT=3001

# seed 环境守卫：DATABASE_URL 的库名不以 _test 结尾时必须显式设为 1，否则 seed 脚本直接退出
ALLOW_SEED=0

# LLM：OpenAI 兼容协议。DeepSeek 用 LLM_PROVIDER=deepseek + 官方 baseURL；
# LLM_PROVIDER=mock 时不发任何外部请求（离线开发 / 集成测试 / CI 用）
LLM_PROVIDER=deepseek
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 静默超时：连续这么久没有新 token 就中断（毫秒）
LLM_TIMEOUT_MS=30000
# 单次生成的总时长上限（毫秒）
LLM_TOTAL_TIMEOUT_MS=120000
# 单条文案字数上限：写进 prompt 的硬约束，控制 token 成本
LLM_MAX_COPY_CHARS=120
