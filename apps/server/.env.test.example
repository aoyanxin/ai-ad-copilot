# 集成测试专用配置：复制本文件为 .env.test 后填入真实密码（.env.test 已被 .gitignore 忽略）
# 键名与 .env 保持一致（DATABASE_URL），测试运行时会用本文件覆盖 .env，避免误连开发库
# 测试库库名必须以 _test 结尾，seed 守卫才会放行 deleteMany
DATABASE_URL="postgresql://postgres:REPLACE_ME@localhost:5432/ai_ad_copilot_test?schema=public"

# 集成测试使用独立 Redis 库（db 1），避免污染开发环境的缓存
REDIS_URL="redis://localhost:6379/1"

# 与开发环境一致的缓存参数，便于断言 TTL = 300
CACHE_TTL_SECONDS=300

# 集成测试绝不打真实 LLM：固定 mock provider（setup.ts 也会强制覆盖一次）
LLM_PROVIDER=mock
